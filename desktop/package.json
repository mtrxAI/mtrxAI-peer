{
  "name": "mtrxai-desktop",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "tauri": "tauri",
    "sync-assets": "node -e \"const fs=require('fs');const dir='dist/assets';fs.mkdirSync(dir,{recursive:true});fs.copyFileSync('../peer/ui/assets/logo.svg',dir+'/logo.svg');\"",
    "predev": "npm run sync-assets",
    "prebuild": "npm run sync-assets",
    "dev": "tauri dev",
    "build": "tauri build",
    "android:init": "tauri android init --ci",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --target aarch64",
    "android:build:debug": "tauri android build --debug --target aarch64",
    "verify:mobile-ui": "node scripts/verify-mobile-ui.js",
    "icon": "tauri icon ../peer/ui/assets/logo.svg -o src-tauri/icons"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
